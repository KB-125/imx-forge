# .clangd
# 统一索引 third_party/{qemu,uboot-mainline,linux_mainline,busybox}；
# 数据库由 scripts/build_helper/gen-compile-commands.sh 生成到 out/compile_commands.json
CompileFlags:
  CompilationDatabase: out
  Remove:
    - -mno-fp-ret-in-387
    - -mpreferred-stack-boundary=*
    - -mindirect-branch=*
    - -mindirect-branch-register
    - -fno-allow-store-data-races
    - -fconserve-stack
    - -mrecord-mcount
    - -mfunction-return=*
    - -mskip-rax-setup
    - -mharden-sls=*
    - -mno-fdpic
    - -fno-ipa-sra
    - -fzero-init-padding-bits=all
    - -fno-guess-branch-probability
    - -mno-thumb-interwork
    - -mthumb-interwork
    - -mword-relocations

Diagnostics:
  Suppress:
    - drv_unknown_argument
    - invalid-token-paste
    - invalid_token_after_toplevel_declarator